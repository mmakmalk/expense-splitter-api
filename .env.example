# Copy this file to .env and set your own values. .env is in .gitignore.
POSTGRES_USER=expense
# Use only letters, digits, - and _ : the password is put into a connection string,
# where ; = ' and $ would break it.
POSTGRES_PASSWORD=change-me-local-only
# Host port for tools like DBeaver. Change it if PostgreSQL already runs on this computer.
POSTGRES_PORT=5432
# Host port for the API (http://localhost:API_PORT/health).
API_PORT=5080
